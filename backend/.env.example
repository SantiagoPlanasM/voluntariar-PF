# ── Entorno ───────────────────────────────────────
NODE_ENV=production

# ── Servidor ──────────────────────────────────────
PORT=3001

# ── Base de datos ─────────────────────────────────
# En Render: conectar PostgreSQL y copiar la Internal URL acá
DATABASE_URL=postgresql://user:password@host:5432/voluntariar
USE_POSTGRES=true

# ── JWT ───────────────────────────────────────────
# Generá un string largo y random, ej: openssl rand -base64 32
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────
# URL de tu frontend en Render
CORS_ORIGINS=https://tu-frontend.onrender.com
