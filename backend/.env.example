# ── Entorno ───────────────────────────────────────
# En local: development
# En Render: production
NODE_ENV=development

# ── Servidor ──────────────────────────────────────
PORT=3001

# ── Base de datos ─────────────────────────────────
# En LOCAL: false (usa SQLite automáticamente, no necesita nada más)
# En Render: true
USE_POSTGRES=false

# Solo completar si USE_POSTGRES=true (Render)
# DATABASE_URL=postgresql://user:password@host:5432/voluntariar

# ── JWT ───────────────────────────────────────────
# En local puede ser cualquier string
# En Render: generá uno con: openssl rand -base64 32
JWT_SECRET=secreto_local_de_desarrollo
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────
# En local: http://localhost:5173
# En Render: https://tu-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173

# ── Frontend (para armar links en los emails) ──────
# En local: http://localhost:5173
# En Render: https://tu-frontend.onrender.com (mismo valor que CORS_ORIGINS)
APP_URL=http://localhost:5173

# ── Email transaccional (Resend) ───────────────────
# Alertas por email: nueva inscripción (a la ONG), aprobación/rechazo (al voluntario).
# Sin RESEND_API_KEY configurada, el envío se omite (se loguea, no rompe nada).
# 1. Creá una cuenta gratis en https://resend.com
# 2. Generá una API key en el dashboard
# 3. Pegala acá abajo
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Remitente. El dominio de pruebas de Resend (onboarding@resend.dev) funciona
# sin verificar nada, pero solo te deja mandar al email con el que te registraste
# en Resend. Para mandarle a cualquier usuario real, verificá tu propio dominio
# en Resend y poné un remitente de ese dominio acá.
EMAIL_FROM=VoluntariAR <onboarding@resend.dev>
#
# MODO PRUEBA — para que los emails te lleguen a vos mientras usás el remitente de pruebas.
# Poné acá EXACTAMENTE el email con el que te registraste en Resend. TODOS los emails
# (inscripciones, aprobaciones, patrocinios) se mandan a esa casilla en vez de a cada usuario,
# con el destinatario original en el asunto ("[para: x@y.com] ...") y en un aviso arriba del
# cuerpo. Sin esto, mandarle a los usuarios del seed (admin@bancoalimentos.org...) da el error
# 403 "Testing domain restriction" de Resend. Si el valor no parece un email, no se manda NADA.
# Con un dominio propio verificado en Resend, dejalo comentado: cada usuario recibe lo suyo.
# EMAIL_REDIRECT_TO=tu-email@ejemplo.com

# ── Fotos de las publicaciones ("Momentos") — Cloudinary ─────────────────────
# Cuenta gratuita en https://cloudinary.com → Dashboard ("Product Environment Credentials").
# Sin estas tres variables la app funciona igual, pero no se pueden subir fotos
# (POST /api/posts responde 503 y el arranque muestra "Fotos: sin configurar").
# CLOUDINARY_API_SECRET es un secreto: va solo en tu .env y en las variables de entorno de Render,
# nunca en el código ni en un commit.
# CLOUDINARY_CLOUD_NAME=tu-nube
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=tu-secreto
# Opcional: carpeta donde se guardan (vacío = sin carpeta).
# CLOUDINARY_FOLDER=voluntariar/posts


# --- Opcionales (ver docs/BACKEND_CONTEXT.md) ---
# Emails (Resend). Sin RESEND_API_KEY los emails se omiten.
# RESEND_API_KEY=
# EMAIL_REDIRECT_TO=     # modo prueba: manda todo a esta casilla
# Fotos de Momentos (Cloudinary). Hacen falta las tres; sin ellas publicar responde 503.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=

# ── Donaciones con Mercado Pago (MODO PRUEBA) ─────────────────────────────────
# Credenciales de PRUEBA de tu aplicación (Tus integraciones). Nunca en un commit.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# Marketplace (§215–§216): cada ONG vincula su cuenta de vendedor de prueba por OAuth.
# MP_CLIENT_ID y MP_CLIENT_SECRET son los de la aplicación; MP_OAUTH_REDIRECT_URI tiene que ser
# EXACTAMENTE la URL de redireccionamiento cargada en la aplicación: <APP_URL>/ngo/mercadopago/vuelta.
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# MP_OAUTH_REDIRECT_URI=http://localhost:5173/ngo/mercadopago/vuelta
# Clave para cifrar los tokens de las ONGs (32 bytes). Generala con:
#   node -p "require('crypto').randomBytes(32).toString('base64')"
# Si la cambiás o la perdés, las ONGs tienen que volver a vincular su cuenta.
# MP_TOKEN_KEY=
